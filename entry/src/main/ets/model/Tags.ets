/**
 * 题材标签体系。
 *
 * ── 为什么放在独立模块 ──
 * 1. 数据模型只负责「装数据」，筛选是可变的业务规则，两者不该耦合；
 * 2. ArkUI 的 @State 观察的是属性变化，模型类里挂方法虽然能跑，
 *    但一旦涉及跨组件传参/序列化，纯函数比实例方法稳得多；
 * 3. 以后接服务端的题材维度（category_dim_theme）时，
 *    只需在 TAG_KEY_MAP 里补映射，UI 和模型都不用动。
 *
 * ── 数据来源说明（有实测依据，不是猜的） ──
 * 2026-11-06 用工程内同一套签名代码在 Node 侧跑了三个频道共 160 部样本：
 *   · feed 的 tags / category_list 全部为空，category_name 一律是「短剧」；
 *   · 真正的题材在 category_schema（JSON 字符串）里，共 138 种不同题材。
 * 所以 ContentApi.parseDrama() 会把 category_schema 的 name 全部解析进 Drama.tagList，
 * 并额外纳入标题——源站题材表里没有「修仙」「科幻」，但标题里大量出现。
 *
 * 下面这些别名是按那 138 个真实题材词频逐一核对后写的，
 * 不是凭想象补同义词。例：言情在源站叫「恋爱 / 爱情 / 都市爱情 / 先婚后爱」，
 * 恐怖叫「惊悚 / 惊悚灵异 / 中式恐怖 / 民俗恐怖」。
 *
 * 不用简介做匹配：简介里出现「不恐怖」「并非言情」这类否定句会误命中。
 */
export const TAG_ALL: string = '全部';

/** 展示顺序：用户最常点的题材靠前，横向可滚动 */
export const VIDEO_TAGS: string[] = [
  TAG_ALL,
  '玄幻', '言情', '科幻', '悬疑', '恐怖', '修仙',
  '都市', '古装', '穿越', '重生', '逆袭', '甜宠'
];

/**
 * 题材别名：展示名与源站措辞不一致时用它补齐。
 * 匹配走「子串包含」，所以这些词要够具体——太短或太泛（例如单字「爱」、
 * 「脑洞」）会把都市脑洞、奇幻爱情全拉进来，宁可少给也不要乱给。
 */
const TAG_ALIASES: Record<string, string[]> = {
  '玄幻': ['奇幻', '魔法', '异世', '异界', '东方玄幻', '玄幻奇幻'],
  '言情': ['恋爱', '爱情', '先婚后爱', '日久生情', '宠妻', '姐弟恋', '虐恋', '总裁', '豪门', '爱恨纠葛'],
  // 源站没有「科幻」这个题材词，只能靠专属度高的近义题材兜底。
  // 实测教训：一开始把「系统 / 异界 / 异能」放进来，命中数虚高到 42/158，
  // 点开一看全是修仙和穿越剧。宁可少给也不要串味。
  '科幻': ['未来', '星际', '机甲', '末世', '灾难'],
  '悬疑': ['推理', '烧脑', '探案', '反转', '解谜', '悬疑推理', '民俗悬疑', '推理解谜'],
  // 「绝地逃生」是冒险求生不是恐怖，实测会带进 5 条不相干的
  '恐怖': ['惊悚', '灵异', '中式恐怖', '民俗恐怖'],
  // 源站同样没有「修仙」，标题是主要来源，补几个修仙专属词
  '修仙': ['仙侠', '修真', '灵根', '仙途', '飞升', '玄门', '仙帝', '证道', '渡劫', '剑神', '宗门'],
  '都市': ['现代', '职场', '商战', '都市日常', '都市高武', '都市脑洞'],
  // 「年代」「民国」是独立的年代剧，塞进古装会让点古装的人看到民国戏
  '古装': ['古代', '宫廷', '架空'],
  '穿越': ['穿书', '快穿'],
  '重生': ['重来', '回到过去', '双重生', '重生逆袭'],
  '逆袭': ['打脸', '逆天', '崛起', '逆风翻盘', '隐藏大佬', '超凡逆袭', '打脸反派'],
  '甜宠': ['甜文', '宠文', '先婚后爱', '宠妻', '日久生情']
};

/** 判断一条剧集是否属于某个题材 */
export function matchesDramaTag(tagList: string[], tag: string): boolean {
  if (tag.length === 0 || tag === TAG_ALL) {
    return true;
  }

  // 先把内容源标签整合成一段文本，一次遍历就能匹配完
  let joined: string = '';
  for (const item of tagList) {
    if (item.length > 0) {
      joined += item + '|';
    }
  }
  if (joined.length === 0) {
    return false;
  }

  // ① 直接命中展示名
  if (joined.indexOf(tag) >= 0) {
    return true;
  }

  // ② 命中别名
  const aliases: string[] | undefined = TAG_ALIASES[tag];
  if (aliases !== undefined) {
    for (const alias of aliases) {
      if (joined.indexOf(alias) >= 0) {
        return true;
      }
    }
  }
  return false;
}

/** 空态提示：明确告诉用户是「没找到」而不是「坏了」，并给出下一步 */
export function tagEmptyHint(tag: string): string {
  return `当前分类下没有「${tag}」题材`;
}
